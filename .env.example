# Envio das candidaturas da página /carreiras (Route Handler /api/candidatura).
# Sem estas variáveis o formulário responde 503 e orienta o candidato a usar o WhatsApp do RH.

# Chave da API do Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Caixa de entrada que recebe os currículos
RH_EMAIL_TO=rh@metalgalvano.com.br

# Remetente verificado no domínio configurado no Resend
RH_EMAIL_FROM=site@metalgalvano.com.br
