# ─────────────────────────────────────────────────────────────────────────────
# Sanity — gerenciamento das obras (/studio). Ver docs/obras-cms.md
# ─────────────────────────────────────────────────────────────────────────────

# ID do projeto em sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Segredo compartilhado com o webhook do Sanity que revalida o cache.
# Gere com: openssl rand -hex 32
SANITY_REVALIDATE_SECRET=

# Token de escrita — SOMENTE local, para rodar scripts/migrate-obras.ts.
# Nunca configurar em produção.
SANITY_API_WRITE_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Envio das candidaturas da página /carreiras (Route Handler /api/candidatura).
# Sem estas variáveis o formulário responde 503 e orienta o candidato a usar o WhatsApp do RH.

# Chave da API do Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Caixa de entrada que recebe os currículos
RH_EMAIL_TO=rh@metalgalvano.com.br

# Remetente verificado no domínio configurado no Resend
RH_EMAIL_FROM=site@metalgalvano.com.br
